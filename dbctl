#!/bin/sh

set -e

# Every path below is relative to the repository root.
cd "$(dirname "$0")"

TESTS_JAR=dlsm-tests/target/dlsm-tests-1.0-SNAPSHOT.jar
SERVER_JAR=dlsm-server/target/dlsm-server-1.0-SNAPSHOT.jar
TEST_USAGE="Usage: ./dbctl test checkpoint-1 [--list | --seed N | --case ID --seed N]"
INSPECT_USAGE="Usage: ./dbctl inspect manifest | wal | sstable <id>"
READY_URL=http://127.0.0.1:8082/health/ready
READY_TIMEOUT_S=20

COMMAND="${1:-}"
if [ $# -gt 0 ]; then
  shift
fi

case "$COMMAND" in
  build)
    # The images build the jars themselves (Dockerfile), so the host needs
    # only Docker. Services with a profile are built only when it is named.
    echo "Building the standalone, inspect and student-tests images..."
    docker compose --profile standalone --profile tools --profile tests build
    ;;
  up)
    PROFILE="$1"
    if [ "$PROFILE" = "standalone" ]; then
      echo "Starting standalone service..."
      docker compose --profile standalone up -d
      # Return only once the node is READY, at most READY_TIMEOUT_S seconds
      # (plan §6.5), so the next command never races its startup.
      waited=0
      until [ "$(curl -s -o /dev/null -w '%{http_code}' "$READY_URL" || true)" = "200" ]; do
        if [ "$waited" -ge "$READY_TIMEOUT_S" ]; then
          echo "standalone is not ready after ${READY_TIMEOUT_S} s; last log lines:" >&2
          docker compose --profile standalone logs --tail 50 standalone >&2
          exit 1
        fi
        sleep 1
        waited=$((waited + 1))
      done
      echo "standalone is ready"
    else
      echo "Usage: ./dbctl up standalone"
      exit 1
    fi
    ;;
  down)
    echo "Stopping containers..."
    docker compose --profile standalone down
    ;;
  reset)
    echo "Resetting environment (removing volumes and reports)..."
    docker compose --profile standalone down -v
    rm -rf reports/*
    ;;
  status)
    docker compose ps
    ;;
  logs)
    docker compose logs -f standalone
    ;;
  test)
    # PI §25.2: the student-tests image runs each scenario against the
    # production server jar as a child process; reports/ is mounted, so
    # reports/checkpoint-1-<seed>.json appears here (PI §25.3). The exit
    # code is the runner's: 0 only when every selected scenario passed.
    if [ "${1:-}" != "checkpoint-1" ]; then
      echo "$TEST_USAGE" >&2
      exit 64
    fi
    shift
    mkdir -p reports
    if [ "${DLSM_TEST_RUNNER:-docker}" = "host" ]; then
      # Development without Docker: Java 21 from JAVA_HOME, else from PATH.
      if [ ! -f "$TESTS_JAR" ] || [ ! -f "$SERVER_JAR" ]; then
        ./mvnw -q package -DskipTests
      fi
      exec "${JAVA_HOME:+$JAVA_HOME/bin/}java" -jar "$TESTS_JAR" "$@"
    fi
    case "$(uname -s)" in
      MINGW*|MSYS*|CYGWIN*)
        exec docker compose --profile tests run --rm student-tests "$@" ;;
      *)
        # Reports are written as the calling user, so `reset` can remove them.
        exec docker compose --profile tests run --rm --user "$(id -u):$(id -g)" student-tests "$@" ;;
    esac
    ;;
  inspect)
    # CP1 §25: the node's volume is inspected by a short-lived helper
    # container that mounts it read-only. stdout is the inspector's JSON
    # report only; the exit code is the inspector's (FORMAT.md §3.7, 64 for
    # a bad command line).
    if [ $# -eq 0 ]; then
      echo "$INSPECT_USAGE" >&2
      exit 64
    fi
    if [ -z "$(docker compose --profile standalone ps -q --status running standalone)" ]; then
      exec docker compose --profile tools run --rm -T inspect "$@"
    fi
    # A running node is frozen for the read (docker compose pause), so nothing
    # writes the volume meanwhile and the inspector sees one moment of it: the
    # read-only snapshot CP1 §25 allows. It is resumed on every exit and never
    # restarted, so no recovery or cleanup runs.
    if ! docker compose --profile standalone pause standalone >/dev/null 2>&1; then
      echo "Cannot pause the running standalone node for inspection" >&2
      exit 1
    fi
    trap 'docker compose --profile standalone unpause standalone >/dev/null 2>&1 ||
      echo "standalone is still paused; run: docker compose unpause standalone" >&2' EXIT
    trap 'exit 130' INT TERM
    code=0
    docker compose --profile tools run --rm -T inspect "$@" || code=$?
    exit "$code"
    ;;
  *)
    echo "Usage: ./dbctl {build|up standalone|down|reset|status|logs|test checkpoint-1 ...|inspect manifest|wal|sstable <id>}"
    exit 1
    ;;
esac